#include <stdio.h>

#include <string.h>

#include <ctype.h>

 

int mod(int x){return (x%26+26)%26;}

int main(void){

    char s[3000]; int freq[26]={0},order[26],total=0;

    /* English frequency order, most common to least common */

    char english[]="ETAOINSHRDLCUMWFGYPBVKJXQZ";

    printf("Enter additive-cipher ciphertext: ");fgets(s,sizeof(s),stdin);

    for(int i=0;s[i];i++)if(isalpha((unsigned char)s[i])){

        freq[toupper((unsigned char)s[i])-'A']++;total++;

    }

    for(int i=0;i<26;i++)order[i]=i;

    for(int i=0;i<26;i++)for(int j=i+1;j<26;j++)

        if(freq[order[j]]>freq[order[i]]){

            int t=order[i];order[i]=order[j];order[j]=t;

        }

    printf("\nTop 10 possible plaintexts (frequency guesses):\n");

    for(int rank=0;rank<10;rank++){

        int shift=mod(order[0]-(english[rank]-'A'));

        printf("\nGuess %d (shift %d): ",rank+1,shift);

        for(int i=0;s[i];i++){

            if(isupper((unsigned char)s[i]))putchar('A'+mod(s[i]-'A'-shift));

            else if(islower((unsigned char)s[i]))putchar('a'+mod(s[i]-'a'-shift));

            else putchar(s[i]);

        }

    }

    printf("\n");

    return 0;

}
