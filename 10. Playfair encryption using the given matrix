#include <stdio.h>

#include <ctype.h>

#include <string.h>

 

char sq[5][5]={{'M','F','H','I','K'},

 {'U','N','O','P','Q'}, {'Z','V','W','X','Y'},

 {'E','L','A','R','G'}, {'D','S','T','B','C'}};

void find(char c,int *r,int *col){

    if(c=='J')c='I';

    for(int i=0;i<5;i++)for(int j=0;j<5;j++)

        if(sq[i][j]==c){*r=i;*col=j;return;}

}

int main(void){

    char raw[1000],p[1000],out[2000]; int n=0,m=0;

    printf("Enter message: "); fgets(raw,sizeof(raw),stdin);

    for(int i=0;raw[i];i++)if(isalpha((unsigned char)raw[i])){

        char c=toupper((unsigned char)raw[i]); if(c=='J')c='I'; p[n++]=c;

    }

    for(int i=0;i<n;){

        char a=p[i++],b;

        if(i==n)b='X'; else if(p[i]==a)b='X'; else b=p[i++];

        int r1,c1,r2,c2;find(a,&r1,&c1);find(b,&r2,&c2);

        if(r1==r2){c1=(c1+1)%5;c2=(c2+1)%5;}

        else if(c1==c2){r1=(r1+1)%5;r2=(r2+1)%5;}

        else {int t=c1;c1=c2;c2=t;}

        out[m++]=sq[r1][c1];out[m++]=sq[r2][c2];

    }

    out[m]='\0';printf("Ciphertext: %s\n",out);

    return 0;

}

